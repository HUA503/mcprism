{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "servers": {
      "example-local": {
        "type": "local",
        "command": ["npx", "-y", "example-mcp-server"],
        "environment": {
          "MCP_API_KEY": "{env:MCP_API_KEY}"
        }
      },
      "example-remote": {
        "type": "remote",
        "url": "https://mcp.example.com/mcp",
        "headers": {
          "Authorization": "Bearer {env:MCP_API_KEY}"
        }
      }
    }
  }
}
